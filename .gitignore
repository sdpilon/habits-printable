node_modules/
dist/
coverage/
test-results/
playwright-report/
*.log
.env*

# OS and editor
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/
.idea/

# Cross-project registry entry (read by ~/.claude/bldoc.toml, not by this repo)
entry-description.md

