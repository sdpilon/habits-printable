{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrackerOptions",
  "description": "Input dictionary passed from the web page to typst/tracker.typ. Supersedes specs/001-printable-habit-grid/contracts/tracker-options.schema.json's 'layout' field with 'shape', 'direction', and 'repeat'.",
  "type": "object",
  "required": [
    "shape",
    "direction",
    "repeat",
    "habits",
    "days",
    "perRow",
    "dotDiameterMm",
    "dotSpacingMm"
  ],
  "additionalProperties": false,
  "properties": {
    "shape": { "type": "string", "enum": ["line", "calendar"] },
    "direction": {
      "type": "string",
      "enum": ["rows", "columns"],
      "description": "Applicable only when shape is 'line'; ignored (no effect on rendering) when shape is 'calendar'."
    },
    "repeat": { "type": "string", "enum": ["stacked", "side-by-side"] },
    "habits": { "type": "integer", "minimum": 1, "maximum": 40 },
    "days": { "type": "integer", "minimum": 1, "maximum": 365 },
    "perRow": { "type": "integer", "minimum": 1, "maximum": 31 },
    "dotDiameterMm": { "type": "number", "minimum": 2, "maximum": 5 },
    "dotSpacingMm": { "type": "number", "minimum": 0.5, "maximum": 5 }
  }
}
